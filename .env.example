# Token bot dari Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# ID koin dari CoinGecko (contoh: bitcoin, ethereum, solana, dll)
COIN_ID=bitcoin

# Mata uang preferensi (usd, idr, eur, dll)
PREFERRED_CURRENCY=usd

# Simbol mata uang (misal $, Rp, €)
CURRENCY_SYMBOL=$

# Apakah simbol di depan? (true/false)
CURRENCY_BEFORE=true

# Pemisah ribuan (contoh: , atau .)
THOUSAND_SEPARATOR=,

# Interval update dalam menit (minimal 1)
UPDATE_FREQUENCY=1
